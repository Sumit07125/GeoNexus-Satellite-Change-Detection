# ==============================================================================
# Geo-Nexus — Git Ignore Rules
# ==============================================================================

# ── Python & Bytecode ─────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
.pytest_cache/

# ── Virtual Environments ──────────────────────────────────────────────────────
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# ── Environment Variables & Secrets ───────────────────────────────────────────
.env
.env.local
.env.*.local
*.pem
*.key
*service_account*.json
*credentials*.json
.earthengine/

# ── Node.js & Frontend ────────────────────────────────────────────────────────
node_modules/
Frontend/dist/
Frontend/dist-ssr/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm/

# ── Large Datasets & Compressed Arrays ────────────────────────────────────────
# Exclude raw OSCD multi-gigabyte dataset & raw training numpy dumps
Model_Training/data/OSCD/
Model_Training/data/OSCD/*
Model_Training/data/**/*.npy
Model_Training/data/**/*.npz
*.npz

# ── Temporary & Scratch Files ─────────────────────────────────────────────────
scratch_*
tmp/
temp/
*.tmp
*.log
.tempmediaStorage/
.system_generated/

# ── Operating System & IDE ────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

.idea/
.vscode/
*.swp
*.swo
*.sublime-workspace
*.sublime-project
