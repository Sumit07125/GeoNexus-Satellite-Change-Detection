# ============================================================
# Geo-Nexus Backend — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# ----------------------------------------------------------
# Google Earth Engine (GEE)
# ----------------------------------------------------------
# REQUIRED for Geo-Nexus AI: replace this placeholder with a real Google Cloud
# project that has the Earth Engine API enabled and your account authorized.
# Placeholder values (including different capitalization) are rejected.
# Run once locally for user credentials: earthengine authenticate
GEE_PROJECT_ID=your-gcp-project-id

# Optional: path to a valid Earth Engine service-account JSON key.
# Leave blank to use valid local user credentials from earthengine authenticate.
GEE_SERVICE_ACCOUNT_KEY=

# ----------------------------------------------------------
# Flask Server
# ----------------------------------------------------------
FLASK_ENV=development
FLASK_DEBUG=1
FLASK_PORT=5000
FLASK_HOST=0.0.0.0

# Optional non-secret build label for deployments without the Git metadata.
# If blank, the backend reports the short local Git revision when available.
GEONEXUS_BUILD_ID=

# Secret key for Flask sessions (generate with: python -c "import secrets; print(secrets.token_hex(32))")
FLASK_SECRET_KEY=change-this-to-a-random-secret-key

# ----------------------------------------------------------
# CORS (Frontend URL)
# ----------------------------------------------------------
# URL of the React frontend - for CORS whitelisting
FRONTEND_URL=http://localhost:5173
# Comma-separated allowed browser origins (defaults to FRONTEND_URL)
CORS_ORIGINS=http://localhost:5173

# ----------------------------------------------------------
# Model Configuration
# ----------------------------------------------------------
# Path to the GeoNexus model folder (relative to backend/)
MODEL_DIR=Model/geonexus_v3_2_k30
MODEL_CHECKPOINT=mh_fewshot_best_k30.pth
MODEL_ARCHITECTURE=p3_geonexus_model.py
NORM_STATS_FILE=norm_stats_trainonly.json
MODEL_MANIFEST=manifest.json

# Default binarization threshold (from manifest: 0.28)
MODEL_THRESHOLD=0.28

# Device: 'cuda' or 'cpu'
DEVICE=cpu

# Optional local admin diagnostic CLI (never exposed by Flask routes)
# Generate a long random token locally; its SHA-256 allow-list belongs in the
# private diagnostic config. Do not commit the token or the private config.
GEONEXUS_DIAGNOSTIC_ADMIN_TOKEN=

# ----------------------------------------------------------
# Satellite Imagery Defaults
# ----------------------------------------------------------
# Max cloud cover percentage for Sentinel-2 scene selection
MAX_CLOUD_PCT=30

# Days to search before/after user-provided date for best clear image
DATE_SEARCH_WINDOW_DAYS=15

# Sentinel-2 RGB visualization min/max (reflectance ×10000)
S2_VIS_MIN=0
S2_VIS_MAX=3000

# Patch size for model inference (must match model: 128)
PATCH_SIZE=128

# ----------------------------------------------------------
# Processing
# ----------------------------------------------------------
# Max thumbnail dimensions returned to frontend (pixels)
THUMB_DIM=512

# Temp directory for intermediate files
TEMP_DIR=./tmp
